{
  "uid": "takehome-live",
  "title": "Live Run",
  "tags": ["takehome"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Throughput",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } } },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(llm_requests_total[30s]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latency percentiles",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(llm_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum by (le) (rate(llm_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(llm_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Connection pool saturation",
      "description": "In-flight requests divided by pool size. Sustained values near 1.0 mean the HTTP pool is the throughput ceiling, not the vendor. This is the most commonly missed bottleneck in async LLM clients.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1.2,
          "min": 0,
          "custom": { "fillOpacity": 15, "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.9 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "llm_pool_saturation_ratio",
          "legendFormat": "{{provider}} saturation",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Event loop lag",
      "description": "Rising lag means the Python client is the constraint. When this climbs, vendor-side latency numbers from this harness are not trustworthy.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.05 },
              { "color": "red", "value": 0.2 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "llm_event_loop_lag_seconds", "legendFormat": "loop lag", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "In-flight requests",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "expr": "llm_inflight_requests", "legendFormat": "in flight", "refId": "A" },
        { "expr": "llm_pool_size", "legendFormat": "pool size", "refId": "B" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Retries and retry budget",
      "description": "A draining retry budget means the client is shedding retries rather than amplifying load against a struggling backend.",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "expr": "sum by (reason) (rate(llm_retry_attempts_total[1m]))",
          "legendFormat": "{{reason}}/s",
          "refId": "A"
        },
        {
          "expr": "llm_retry_budget_tokens",
          "legendFormat": "budget tokens",
          "refId": "B"
        }
      ]
    }
  ]
}
